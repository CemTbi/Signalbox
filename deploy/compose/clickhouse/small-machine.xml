<!--
  Keeps ClickHouse modest on a single machine shared with PostgreSQL and
  Signalbox. Larger installations should drop this file and size ClickHouse
  for their span volume.
-->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>

    <!-- Cap ClickHouse at half of the machine's memory. -->
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>

    <!-- System tables that grow quickly and that Signalbox doesn't read. -->
    <query_thread_log remove="1"/>
    <query_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
</clickhouse>
